    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Your server in your pocket</string>
    <string name="onboarding_welcome_text">See who is online, keep an eye on performance, chat with players and run commands – live and encrypted.</string>
    <string name="onboarding_plugin_title">Install the plugin</string>
    <string name="onboarding_plugin_text">Put the RemoteMC plugin into the plugins folder of your Paper, Purpur, Folia or Spigot server (1.20.6 or newer) and restart it.</string>
