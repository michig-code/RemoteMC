<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteMC uses HTTPS with a pinned certificate by default. Plain HTTP stays possible for
     servers that disabled TLS (e.g. behind a local reverse proxy); the app warns about it. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
