<?xml version="1.0" encoding="utf-8"?>
<!-- Server tokens are encrypted with a device-bound key; backups could not be decrypted anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
