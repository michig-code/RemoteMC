/* German texts of the iPhone test version (keys are the English texts). */
"No servers yet" = "Noch keine Server";
"Type /remotemc pair on your server and scan the QR code with the iPhone camera – or tap + and enter the code." = "Gib /remotemc pair auf deinem Server ein und scanne den QR-Code mit der iPhone-Kamera – oder tippe auf + und gib den Code ein.";
"Add server" = "Server hinzufügen";
